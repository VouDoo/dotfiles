{{- /* vim: set ft=toml: */ -}}
# https://docs.noctalia.dev/umbriel/window-rules/
# https://docs.noctalia.dev/umbriel/layer-rules/

# Disable window blur by default, using the cached wallpaper blur when enabled
[[window_rule]]
blur = false
blur_optimized = true

# Float the Noctalia settings window
[[window_rule]]
match.app_id = "^dev.noctalia.Noctalia$"
default_floating = true
default_floating_size_px = { width = 1020, height = 900 }

# Float the screen share picker
[[window_rule]]
match.app_id = "^dev.noctalia.UmbrielSharePicker$"
default_floating = true
default_floating_size_px = { width = 800, height = 600 }

# Float Picture-in-Picture windows in the bottom right corner
[[window_rule]]
match.title = "^(Picture-in-Picture|Picture in picture)$"
default_floating = true
default_maximize = false
default_position = { x = 20, y = 20, anchor = "bottom_right" }

{{- if .features.steam }}

# Prevent Steam from stealing focus when it pops up on its own
[[window_rule]]
match.app_id = "^steam$"
default_focused = false

# Float and pin Steam notification toasts in the corner
[[window_rule]]
match.app_id = "^steam$"
match.title = "^notificationtoasts_.+_desktop"
default_floating = true
default_position = { x = 0, y = 0, anchor = "bottom_right" }
default_focused = false
default_pinned = true

# Keep the pointer inside game windows
[[window_rule]]
match.app_id = "^steam_app_.*$"
confine_pointer = true

# Use variable refresh rate in games
[[window_rule]]
match.app_id = "^steam_app_.*$"
vrr = "always"
{{- end }}

# Open the browser focused, and maximized if enabled
[[window_rule]]
match.app_id = "^brave-origin$"
default_focused = true
default_maximize = {{ .window.browser_maximized }}

# Blur what shows through Ghostty's transparent background
[[window_rule]]
match.app_id = "^com.mitchellh.ghostty$"
blur = true

# Hide KeePassXC from screen captures
[[window_rule]]
match.app_id = "^org.keepassxc.KeePassXC$"
block_capture = true

# Disable blur on Noctalia surfaces, skipping low-alpha pixels and including popups when enabled
[[layer_rule]]
match.namespace = "^noctalia-(bar-[^\"]+|notification|dock|panel|attached-panel|osd|desktop-widget-[^\"]*)$"
blur = false
blur_ignore_alpha = 0.5
blur_popups = true

# Use live blur on surfaces that open over windows, not the cached wallpaper blur
[[layer_rule]]
match.namespace = "^noctalia-(notification|dock|panel|attached-panel|osd)$"
blur_optimized = false
