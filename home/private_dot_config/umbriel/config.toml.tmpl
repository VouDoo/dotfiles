{{- /* vim: set ft=toml: */ -}}
# Complete reference: https://docs.noctalia.dev/umbriel/

# https://docs.noctalia.dev/umbriel/configuration/#include
[include]
files = [
  "environment.toml",
  "appearance.toml",
  "animation.toml",
  "input.toml",
  "keybinds.toml",
  "layout.toml",
  "rules.toml",
  "misc.toml",
]

[include.optional]
files = ["local.toml", "noctalia.toml"]

# https://docs.noctalia.dev/umbriel/configuration/#general
[general]
autostart = [
  "noctalia",
  "kanshi",
  "pw-play --volume 0.95 ~/.local/share/sounds/parallel-windows/stereo/desktop-login.ogg",
  "{{ .terminal.command }}",
]
mod_key = "Super"
show_cheatsheet = false
