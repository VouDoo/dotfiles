{{- /* vim: set ft=kdl: */ -}}
window-rule {
    geometry-corner-radius 6
    clip-to-geometry true
    draw-border-with-background false
}

// Application-specific window rules
window-rule {
    // Blur what shows through Ghostty's transparent background
    match app-id="^com.mitchellh.ghostty$"
    background-effect {
        blur true
    }
}
window-rule {
    // Force Browser to always open focused and maximized (if enabled)
    match app-id="^brave-origin$"
    open-focused true
    open-maximized {{ .window.browser_maximized }}
}
window-rule {
    // Block out password managers from screencasts
    match app-id="^org\\.keepassxc\\.KeePassXC$"
    block-out-from "screen-capture"
}
{{- if .features.steam }}
window-rule {
    // Prevent Steam from stealing focus when it pops up on its own
    match app-id="^steam$"
    open-focused false
}
window-rule {
    // Float Steam notification toasts in the corner
    match app-id="steam" title=r#"^notificationtoasts_\d+_desktop$"#
    open-floating true
    default-floating-position x=10 y=10 relative-to="bottom-right"
}
{{- end }}

layer-rule {
    match namespace="^noctalia-wallpaper*"
    place-within-backdrop true
}
