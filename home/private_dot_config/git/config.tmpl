{{- /* vim: set ft=gitconfig: */ -}}
[user]
	name = {{ .user.fullname }}
	email = {{ .user.email }}

[core]
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	line-numbers = true

[diff]
	# Better diffs when code moves around, and moved lines are colored differently
	algorithm = histogram
	colorMoved = default

[merge]
	conflictstyle = zdiff3

[rerere]
	# Remember how conflicts were resolved and replay them next time
	enabled = true

[pull]
	rebase = true

[rebase]
	autoStash = true
	# Squash fixup! commits automatically, and move stacked branches along
	autoSquash = true
	updateRefs = true

[push]
	# 'git push' on a new branch creates it on the remote
	autoSetupRemote = true

[fetch]
	# Remove remote branches that were deleted on the remote
	prune = true

[commit]
	# Show the diff in the commit message editor
	verbose = true

[tag]
	sort = version:refname

[branch]
	# Most recently used branches first
	sort = -committerdate

[help]
	autocorrect = prompt

[color]
	ui = auto

[filter "lfs"]
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process

[init]
	defaultBranch = main
