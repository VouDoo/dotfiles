{{- /* vim: set ft=gitconfig: */ -}}
{{- /* NOTE: Signing is skipped until the SSH key exists (once created, the next 'chezmoi apply' enables it). */ -}}
{{- $signingKey := joinPath .chezmoi.homeDir ".ssh/id_ed25519.pub" -}}
{{- $sign := stat $signingKey -}}
[user]
	name = {{ .user.fullname }}
	email = {{ .user.email }}
{{- if $sign }}
	signingKey = {{ $signingKey }}
{{- end }}

[core]
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	line-numbers = true

[diff]
	# Better diffs when code moves around, and moved lines are colored differently
	algorithm = histogram
	colorMoved = default

[merge]
	conflictstyle = zdiff3

[rerere]
	# Remember how conflicts were resolved and replay them next time
	enabled = true

[pull]
	rebase = true

[rebase]
	autoStash = true
	# Squash fixup! commits automatically, and move stacked branches along
	autoSquash = true
	updateRefs = true

[push]
	# 'git push' on a new branch creates it on the remote
	autoSetupRemote = true

[fetch]
	# Remove remote branches that were deleted on the remote
	prune = true

[commit]
	# Show the diff in the commit message editor
	verbose = true
{{- if $sign }}
	gpgSign = true
{{- end }}

[tag]
	sort = version:refname
{{- if $sign }}
	gpgSign = true
{{- end }}

[branch]
	# Most recently used branches first
	sort = -committerdate

[help]
	autocorrect = prompt

[color]
	ui = auto

[filter "lfs"]
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process

[init]
	defaultBranch = main
{{- if $sign }}

# Sign with the SSH key (add it to GitHub as a signing key for the "Verified" badge)
[gpg]
	format = ssh

[gpg "ssh"]
	allowedSignersFile = {{ joinPath .chezmoi.homeDir ".config/git/allowed_signers" }}
{{- end }}
