{{- /* vim: set ft=toml: */ -}}
[shell]
font_family = "{{ .font.regular }}"

    [shell.panel]
    open_near_click_control_center = true

    [shell.animation]
    enabled = false

[control_center.calendar]
show_events_card = false

[audio]
enable_sounds = true
sound_theme = "parallel-windows"

[theme]
community_palette = "Everforest"
mode = "dark"
source = "community"

    [theme.templates]
    builtin_ids = [ "btop", "gtk3", "gtk4", "qt", "ghostty", "niri", "umbriel" ]
    community_ids = [ "pi-agent", "bat", "yazi" ]

[desktop_widgets]
enabled = false

[widget.media]
hide_when_no_media = true

[plugins]
enabled = [ "oldirtty/color_picker" ]

[widget.clock]
anchor = true
font_scale = 1.15
tooltip_format = "Date {:%D}"

[widget.color_picker]
type = "oldirtty/color_picker:widget"

[bar.default]
margin_ends = 6
background_opacity = 0.85
start = [ "control-center", "workspaces", "media" ]
center = [ "clock", "world_clock" ]
end = [ "group:apps", "cpu", "ram", "network", "bluetooth", "brightness", "volume", "battery", "notifications" ]

    [[bar.default.capsule_group]]
    id = "apps"
    members = [ "tray", "clipboard", "color_picker" ]

