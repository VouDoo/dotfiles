{{- /* vim: set ft=sh: */ -}}
#!/usr/bin/env sh

###############################################################################
# mise Tools
#
# Description:
#   Installs the global mise tools from ~/.config/mise/config.toml.
#   Runs after the files are applied, and again whenever the mise config changes.
#
# mise config hash: {{ include "private_dot_config/mise/config.toml.tmpl" | sha256sum }}
#
###############################################################################

set -e

mise install
{{- if .features.kubernetes }}

# krew installs itself into ~/.krew/bin (added to PATH by fish) as the kubectl-krew plugin,
# and downloads its plugin index. mise only provides the bootstrap binary.
if [ ! -x "$HOME/.krew/bin/kubectl-krew" ]; then
  echo "Installing krew..."
  mise exec -- krew install krew || echo "Could not install krew, run 'krew install krew' later."
fi
{{- end }}
