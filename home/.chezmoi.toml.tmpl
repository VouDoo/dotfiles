{{- /* vim: set ft=toml: */ -}}
[diff]
    command = "delta"
    pager = "delta"

[data]
    # Editor
    editor = {{ promptStringOnce . "editor" "Default editor to use" "nvim" | quote }}

    # Terminal
    terminal_font_size = {{ promptIntOnce . "terminal_font_size" "Font size for Terminal" 12 }}

    # Window manager
    browser_maximized = {{ promptBoolOnce . "browser_maximized" "Open browser windows maximized" true }}

[data.user]
    {{- $firstname := promptStringOnce . "user.firstname" "First name" }}
    {{- $lastname := promptStringOnce . "user.lastname" "Last name" }}
    firstname = {{ $firstname | quote }}
    lastname = {{ $lastname | quote }}
    fullname = {{ cat $firstname $lastname | quote }}
    email = {{ promptStringOnce . "user.email" "Email address" | quote }}
    github_username = {{ promptStringOnce . "user.github_username" "GitHub username" "VouDoo" | quote }}

[data.font]
    # 0xProto Nerd Font (installed by the setup script as ttf-0xproto-nerd)
    regular = "0xProto Nerd Font"
    mono = "0xProto Nerd Font Mono"

[data.keyboard]
    {{- $keyboardLayout := promptStringOnce . "keyboard.layout" "XKB keyboard layout" "us" }}
    {{- $keyboardVariant := promptStringOnce . "keyboard.variant" "XKB keyboard variant (\"none\" to disable)" "altgr-intl" }}
    {{- $keyboardOptions := promptStringOnce . "keyboard.options" "XKB keyboard options (\"none\" to disable)" "compose:rctrl" }}
    layout = {{ $keyboardLayout | quote }}
    variant = {{ ternary "" $keyboardVariant (eq $keyboardVariant "none") | quote }} # empty when disabled
    options = {{ ternary "" $keyboardOptions (eq $keyboardOptions "none") | quote }} # empty when disabled

[data.features]
    # Steam: niri window rules (focus stealing, floating toasts)
    steam = {{ promptBoolOnce . "features.steam" "Enable Steam config" false }}
    # Podman: podman, podman-compose, lazydocker, lazypodman wrapper, API socket
    podman = {{ promptBoolOnce . "features.podman" "Enable Podman (containers) config" false }}
