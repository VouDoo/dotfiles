[diff]
    command = "delta"
    pager = "delta"

[data]
    # Personal details
    {{- $firstname := promptStringOnce . "firstname" "First name" }}
    {{- $lastname := promptStringOnce . "lastname" "Last name" }}
    firstname = {{ $firstname | quote }}
    lastname = {{ $lastname | quote }}
    fullname = {{ cat $firstname $lastname | quote }}
    email = {{ promptStringOnce . "email" "Email address" | quote }}
    github_username = {{ promptStringOnce . "github_username" "GitHub username" "VouDoo" | quote }}

    # Fonts
    {{- $fontNerdFamily := promptStringOnce . "font_nerd_family" "Nerd Fonts font family to use" "0xProto" }}
    font_nerd_family = {{ $fontNerdFamily | quote }} # Nerd Fonts font family name
    font_regular = {{ cat $fontNerdFamily "Nerd Font" | quote }} # regular font family (auto-generated based on font_nerd_family value)
    font_mono = {{ cat $fontNerdFamily "Nerd Font Mono" | quote }} # monospace font family (auto-generated based on font_nerd_family value)

    # Terminal
    terminal_font_size = {{ promptIntOnce . "terminal_font_size" "Font size for Terminal" 12 }}

    # Editor
    editor = {{ promptStringOnce . "editor" "Default editor to use" "nvim" | quote }}

    # Window manager
    browser_maximized = {{ promptBoolOnce . "browser_maximized" "Open browser windows maximized" true }}
